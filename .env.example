# AI Quant Copilot — environment variables template.
# Copy to `.env.local` (dev) or `.env` (prod) and fill in real values.
# Never commit a populated env file.

# --- Database ---------------------------------------------------------------
# Postgres connection string used by Prisma.
# Example dev: postgresql://aiquant:devpass@localhost:5433/ai_quant_copilot
DATABASE_URL=

# --- NextAuth v5 ------------------------------------------------------------
# Generate with: `openssl rand -base64 32`
AUTH_SECRET=

# Absolute URL of the deployment (no trailing slash).
# Dev: http://localhost:3000
# Prod: https://aiquant.kwinweng.com
AUTH_URL=

# Set to "true" when the app sits behind a reverse proxy (e.g. Nginx) so
# Auth.js trusts the forwarded host header.
AUTH_TRUST_HOST=true

# --- GitHub OAuth provider --------------------------------------------------
# Create at https://github.com/settings/developers
# Authorization callback URL must be: ${AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
