// AI Quant Copilot — Stage 2.1 schema
// NextAuth v5 + business tables, all isolated per user via userId FK.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// NextAuth.js v5 — required tables for PrismaAdapter
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  studies       Study[]
  // Phase 10 — paper trading portfolios derived from completed studies.
  paperPortfolios PaperPortfolio[]
  // Phase 12 — monthly rebalance advice (deduped by user via portfolio FK).
  paperAdvices    PaperRebalanceAdvice[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Business tables — every row is owned by a User via userId
// ============================================================

enum StudyStatus {
  DRAFT
  PLANNED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Study {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Phase 16 — at most one active public share token per study.
  shareToken  StudyShareToken?
  title      String
  hypothesis String         @db.Text
  market     String
  universe   String
  startDate  DateTime
  endDate    DateTime
  rebalance  String
  benchmark  String
  txCostBps  Int
  status     StudyStatus    @default(DRAFT)
  // Phase 3.2 — experiment management. Defaults preserve old rows.
  tags       String[]       @default([])
  favorited  Boolean        @default(false)
  archived   Boolean        @default(false)
  // Phase 4 — factor mix. "momentum" = legacy 12-1 only; "multifactor" =
  // equal-weight Value + Quality + Momentum composite. Defaults to momentum
  // so old studies and form submissions continue to work.
  factorMix  String         @default("momentum")
  // Phase 7 — transaction cost model. "simple" preserves the original
  // uniform-bps × turnover behavior (default for backwards compatibility);
  // "tiered" applies liquidity-tier-aware spreads + sqrt(turnover) market
  // impact + user commission on top.
  costModel  String         @default("simple")
  // Phase 14 — portfolio risk constraints applied at each rebalance. Empty
  // object on legacy rows preserves the equal-weight-no-cap behavior. Shape:
  // { maxPositionWeight?: 0.2, maxSectorWeight?: 0.35, optimizer?: "equal_weight" }
  // (volTarget / min_var deferred — see ROADMAP.md Phase 14 范围外)
  constraints Json          @default("{}")
  plan       StudyPlan?
  progress   StudyProgress?
  result     StudyResult?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([userId, archived])
  @@index([userId, favorited])
  // Sprint #6 M4: GIN index on tags so dashboard tag filter doesn't seq-scan
  // once a workspace grows past a few hundred studies.
  @@index([tags], type: Gin)
}

model StudyPlan {
  studyId          String   @id
  study            Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  dataRequirements String   @db.Text
  factorDefs       String   @db.Text
  backtestRules    String   @db.Text
  riskChecks       String   @db.Text
  limitations      String   @db.Text
  createdAt        DateTime @default(now())
}

model StudyProgress {
  studyId     String   @id
  study       Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  currentStep Int
  steps       Json
  logs        Json
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudyResult {
  studyId           String   @id
  study             Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  conclusion        String   @db.Text
  metrics           Json
  equityCurve       Json
  drawdown          Json
  annualReturns     Json
  factorDiagnostics Json
  aiExplanation     Json
  // Phase 3.1 additions — all default to empty so old rows continue to work.
  monthlyReturns       Json @default("[]")
  rebalanceHistory     Json @default("[]")
  dataQuality          Json @default("{}")
  parameterSensitivity Json?
  // Phase 4 — multi-factor diagnostics. Null for legacy/momentum-only studies.
  factorCoverage       Json?
  factorBreakdown      Json?
  // Phase 8 — robustness report (in/out-of-sample split + bootstrap CI +
  // subperiod metrics). Null for legacy results that pre-date the column.
  robustness           Json?
  // Phase 9 — multi-benchmark OLS attribution (alpha/beta/R² vs SPY/QQQ/IWM/
  // MTUM/IUSV). Null on legacy results.
  benchmarkAttribution Json?
  // Phase 13 — multi-agent investment debate. Cache for the Regan/Jayzee/Quinn
  // transcript + final probability-weighted recommendation. Null until the
  // user explicitly generates a debate on the result page.
  aiDebate             Json?
  // Phase 14 — sector allocation time series for the chosen rebalance dates.
  // Each entry: { date: YYYY-MM, sectors: { Tech: 0.3, Financials: 0.2, ... } }.
  // Null on legacy results that pre-date sector tagging.
  sectorAllocation     Json?
  createdAt         DateTime @default(now())
}

// ============================================================
// Phase 16 — Public study share tokens
// ============================================================
//
// A user can mint at most one active share token per study (studyId is
// UNIQUE). The token grants public, no-auth read access to a stripped-down
// view of the study's result. Regenerating rotates the token (resets
// viewCount); revoking deletes the row entirely.
//
// We track viewCount + lastAccessedAt for the share modal so the owner can
// see whether anyone's actually opening the link. View bumps are fire-and-
// forget — they MUST NOT block the public page render.
model StudyShareToken {
  id             String    @id @default(cuid())
  studyId        String    @unique
  study          Study     @relation(fields: [studyId], references: [id], onDelete: Cascade)
  userId         String    // denormalized owner for fast ACL checks
  token          String    @unique  // 32-byte base64url, unguessable
  viewCount      Int       @default(0)
  lastAccessedAt DateTime?
  // Null → never expires. Reserved for a future "expiring share link" UX.
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

// ============================================================
// Phase 4 — fundamentals cache (Yahoo + SEC EDGAR hybrid)
// ============================================================
//
// One row per (ticker, source, fiscalDate). This is a *cache* — not a study
// artifact — so it's not scoped to userId; everyone benefits from the same
// fetched data. Re-fetch policy is "stale after 24h" implemented in the
// cache layer.
model FundamentalSnapshot {
  ticker        String
  source        String   // "yahoo" | "sec" | "merged"
  fiscalDate    DateTime // last reported fiscal period end (or "now" for Yahoo TTM)
  asOf          DateTime @default(now()) // when *we* fetched/computed this row
  reportedAt    DateTime? // for SEC: when the filing was submitted (PIT anchor)
  // Value
  pe            Float?
  pb            Float?
  ps            Float?
  evEbitda      Float?
  // Quality
  roe           Float?
  roic          Float?
  grossMargin   Float?
  debtToEquity  Float?
  // Growth
  revenueGrowth Float?
  epsGrowth     Float?
  // Phase 5: current MarketCap (USD), used to back-derive historical
  // MarketCap_M = MarketCap_today × (adjclose_M / adjclose_today). Only
  // populated by Yahoo source; SEC source leaves it null.
  marketCap     Float?
  // Phase 5: absolute USD values from SEC filings — required inputs for
  // computing PE/PB/PS at any historical month. Populated by SEC source
  // for each historical 10-K snapshot; Yahoo leaves them null.
  netIncomeTTM       Float?
  revenuesTTM        Float?
  stockholdersEquity Float?
  // Audit / debug — original payload so we can re-derive without re-fetching.
  raw           Json?

  @@id([ticker, source, fiscalDate])
  @@index([ticker, asOf])
  @@index([source, asOf])
}

// ============================================================
// Phase 10 — Paper trading
// ============================================================
//
// A PaperPortfolio is a snapshot of a completed study's last-rebalance
// holdings plus equal-weight starting value of $100k. We track the
// portfolio's value over time by re-pricing the holdings against Yahoo's
// latest monthly closes when the user opens the page. There's no
// scheduled refresh / email alerts in this phase; users pull data when
// they look. Future phases can layer on cron + notifications.
model PaperPortfolio {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Source study + the rebalance event used to seed the portfolio.
  sourceStudyId   String
  sourceRebalanceDate String  // YYYY-MM, the rebalance picked (usually latest)
  // Display
  title           String
  // Holdings as { ticker: weight } where weights sum to 1. Equal-weighted
  // by default but the JSON shape allows future drift / overrides.
  holdings        Json
  // Initial portfolio value (USD). Default $100k for round-number tracking.
  initialValue    Float    @default(100000)
  // Benchmark to compare against (default copies the source study).
  benchmark       String   @default("SPY")
  // The "start" anchor — usually the rebalance date so the curve starts at
  // initialValue. Used by the refresh logic to compute share counts.
  startedAt       DateTime @default(now())
  // Optional: archived hides it from the default list view.
  archived        Boolean  @default(false)
  notes           String?  @db.Text
  // Phase 12 — monthly rebalance advice. One PaperPortfolio has many
  // PaperRebalanceAdvice rows, at most one per (portfolio, suggestedMonth).
  advices         PaperRebalanceAdvice[]
  // Phase 15 — cached quarterly calibration review. Shape:
  // { computedAt, periodStart, periodEnd, hitRate, trackingError,
  //   executionRate, actualCagr, expectedCagr, aiSummary, monthsObserved }
  // Recomputed every 7 days; null until first /paper/[id]/review call.
  quarterlyReview Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, archived])
  @@index([sourceStudyId])
}

// ============================================================
// Phase 12 — Paper rebalance advice (scheduler + Telegram)
// ============================================================
//
// The monthly scheduler re-runs each active PaperPortfolio's source study
// against the latest fully-closed month and writes a PaperRebalanceAdvice
// row capturing the diff between currently-held tickers and the strategy's
// recommendation. We notify via Telegram and surface a "pending" badge in
// the UI. The user can then `confirm` (which updates the portfolio's
// holdings + bumps sourceRebalanceDate) or `skip`. Status defaults to
// `pending`. We do NOT auto-rebalance — this keeps the user in the loop
// and protects against scheduler bugs silently scrambling a portfolio.
enum PaperAdviceStatus {
  pending
  confirmed
  skipped
}

model PaperRebalanceAdvice {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperPortfolioId  String
  paperPortfolio    PaperPortfolio @relation(fields: [paperPortfolioId], references: [id], onDelete: Cascade)
  // YYYY-MM the advice was generated FOR (the "decision month" — the last
  // fully-closed month the scheduler could see when it ran).
  suggestedMonth    String
  // The strategy's recommended holdings at suggestedMonth, equal-weighted.
  suggestedTickers  String[]
  // What the portfolio was holding at the time advice was generated.
  currentTickers    String[]
  // Pre-computed diff sets for fast UI + Telegram rendering.
  addedTickers      String[]
  removedTickers    String[]
  // Optional: average composite z-score of the suggested holdings, useful
  // for "the strategy is very bullish / neutral" context lines. Nullable
  // because legacy momentum-only studies won't have a composite figure.
  avgScore          Float?
  status            PaperAdviceStatus @default(pending)
  // When the user acted on the advice (confirmed or skipped). Null while pending.
  actedAt           DateTime?
  // Optional: short note describing why the advice was generated (e.g.
  // "monthly cadence", "manual trigger"). Free text for the audit trail.
  reason            String?  @db.Text
  // Telegram delivery audit — null if disabled / missing config / failed.
  notifiedAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([paperPortfolioId, suggestedMonth])
  @@index([userId, status])
  @@index([paperPortfolioId, status])
}

// Per-user per-day AI call counters for cheap rate limiting. We don't need a
// real bucket; daily reset is sufficient for the demo budget.
model AiUsageDay {
  userId          String
  date            DateTime // truncated to YYYY-MM-DD UTC
  planCalls       Int      @default(0)
  conclusionCalls Int      @default(0)
  // Phase 4 follow-up Sprint #3: hypothesis coach turns. Counted separately
  // because a coach session can fire many turns and we want to monitor /
  // tune its quota independently from plan/conclusion.
  coachCalls      Int      @default(0)
  // Phase 13: multi-agent investment debate runs (one debate = ~4 LLM calls
  // but billed as a single quota unit per generation). Daily quota lower than
  // coach/plan/conclusion because each debate is expensive.
  debateCalls     Int      @default(0)
  // Phase 15: per-portfolio quarterly review AI summary generations. Billed
  // separately so we can monitor calibration-tab usage independent of the
  // conclusion / plan / debate quotas.
  reviewCalls     Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@id([userId, date])
}
